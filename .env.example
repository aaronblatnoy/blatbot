# --- Inkbox identity (required) ---
INKBOX_API_KEY=ApiKey_xxxxxxxxxxxx
INKBOX_IDENTITY=my-agent-handle
INKBOX_SIGNING_KEY=whsec_xxxxxxxxxxxx

# --- Inkbox (optional) ---
# INKBOX_BASE_URL=https://inkbox.ai
# INKBOX_PUBLIC_URL=https://your-public-host.example   # omit to use an Inkbox tunnel
# INKBOX_TUNNEL_NAME=my-agent-handle
# INKBOX_ALLOW_ALL_USERS=true                          # rely on Inkbox contact rules
# INKBOX_ALLOWED_USERS=+15551234567,me@example.com     # optional local allowlist
# INKBOX_REQUIRE_SIGNATURE=true
# INKBOX_EXTERNAL_EVENTS_ENABLED=false               # wake the agent on unrecognised/unverified external webhooks
# INKBOX_CONTACT_MEMORIES_ENABLED=true                # include matched-contact memories in human turns
# INKBOX_WEBHOOK_SECRET_GITHUB=...                   # verification secret for a registered third-party source
# INKBOX_BRIDGE_PORT=8767

# --- Phone call voice stack ---
# INKBOX_VOICE_STACK=inkbox_tts_stt              # inkbox_voice_ai | openai_realtime | inkbox_tts_stt
# INKBOX_VOICE_AI_AUTHORITY_MODE=contact_scoped   # local mirror for doctor; contact_scoped | yolo
# INKBOX_VOICEMAIL_DETECTION=enabled              # enabled | disabled

# --- Realtime voice (optional; select INKBOX_VOICE_STACK=openai_realtime) ---
# INKBOX_REALTIME_ENABLED=true
# INKBOX_REALTIME_API_KEY=sk-realtime
# OPENAI_API_KEY=sk-openai-fallback
# INKBOX_REALTIME_MODEL=gpt-realtime-2
# INKBOX_REALTIME_VOICE=cedar
# INKBOX_REALTIME_FALLBACK_TO_INKBOX_STT_TTS=true

# --- Claude Code ---
CLAUDE_PROJECT_DIR=/path/to/the/repo/claude/should/work/in
# CLAUDE_MODEL=claude-fable-5
# INKBOX_PERMISSION_TIMEOUT_S=600
# Tools that never need a permission text (comma-separated):
# INKBOX_AUTO_ALLOWED_TOOLS=Read,Glob,Grep,WebFetch,WebSearch,TodoWrite,Task,NotebookRead

# --- Owner and assistant identity ---
# Every prompt, label and judgment the gate writes is built from these; leave
# unset and the package runs with generic placeholder wording instead.
OWNER_NAME=Jane Doe
OWNER_FIRST_NAME=Jane
ASSISTANT_NAME=Nova
ASSISTANT_EMAIL=my-agent-handle@inkboxmail.com
SERVER_NAME=my-server
# ASSISTANT_PRONUNCIATION=NO-vah                     # how callers say the name (voice vocabulary)
# ASSISTANT_NAME_ALIASES=nov                         # short names that address the assistant in a group chat

# SCOPES_PATH=~/blatbot/config/scopes.yaml   # private scope registry; see inkbox_claude/gate/scopes.example.yaml
# INKBOX_STRANGER_EXTRA_TOOLS=   # extra tools a non-owner session may run without asking (comma-separated)
# GATE_ORG_GOOGLE_ACCOUNT=org@example.org    # the Google account org-scoped workspace tools act as
# GATE_OWNER_GOOGLE_ACCOUNT=owner@example.edu   # the Google account owner-scoped workspace tools act as
